{
  "name": "gentle-playbook",
  "version": "0.8.0",
  "description": "Architectural Playbook & Essence Manager for Pi and el Gentleman",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:opencode": "esbuild src/opencode.ts --bundle --platform=node --format=esm --target=node18 --external:@opencode/plugin --external:@opencode/* --outfile=dist/opencode.js"
  },
  "keywords": [
    "pi-package",
    "gentle-ai",
    "playbook",
    "pi-extension",
    "architecture"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "author": "darkkevo",
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@opencode/plugin": "2.0.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.6"
  }
}
